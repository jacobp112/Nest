(TEMPLATES[0].id);const[targetUserEmail,setTargetUserEmail]=useState('test@nest.finance');const activeTemplateData=useMemo(()=>templates.find(t=>t.id===activeTemplate),[templates,activeTemplate]);const[isSending,setIsSending]=useState(false);const[lastSentTime,setLastSentTime]=useState(null);const handleSend=()=>{if(!activeTemplateData||isSending)return;setIsSending(true);// Simulate API call to ESP\nsetTimeout(()=>{setIsSending(false);setLastSentTime(new Date());onInteract(\"Sent \".concat(activeTemplateData.name,\" to \").concat(targetUserEmail));},2000);};return/*#__PURE__*/_jsx(\"div\",{className:\"pt-2\",children:/*#__PURE__*/_jsxs(\"div\",{className:\"grid grid-cols-12 gap-6\",children:[/*#__PURE__*/_jsxs(\"div\",{className:\"col-span-12 lg:col-span-3 space-y-4\",children:[/*#__PURE__*/_jsxs(DashboardCard,{className:\"p-4 flex items-center justify-between border-0 ring-1 ring-white/5 bg-slate-900/50\",children:[/*#__PURE__*/_jsxs(\"h3\",{className:\"text-lg font-bold text-white flex items-center gap-2\",children:[/*#__PURE__*/_jsx(Mail,{size:18,className:\"text-indigo-400\"}),\" Templates\"]}),/*#__PURE__*/_jsx(\"div\",{className:\"flex items-center gap-3\",children:/*#__PURE__*/_jsx(Settings,{size:16,className:\"text-slate-500 hover:text-white cursor-pointer\",onClick:()=>onInteract('Open ESP Settings')})})]}),/*#__PURE__*/_jsx(\"div\",{className:\"space-y-2\",children:templates.map(template=>/*#__PURE__*/_jsxs(motion.button,{onClick:()=>setActiveTemplate(template.id),className:\"w-full text-left p-4 rounded-xl border transition-all duration-300 \".concat(activeTemplate===template.id?'bg-indigo-600 border-indigo-500 shadow-lg shadow-indigo-900/40 text-white':'bg-slate-900/40 border-white/5 hover:bg-slate-800/60 text-slate-300'),children:[/*#__PURE__*/_jsx(\"h4\",{className:\"font-bold text-sm\",children:template.name}),/*#__PURE__*/_jsx(\"p\",{className:\"text-[10px] mt-1 opacity-75\",children:template.desc})]},template.id))})]}),/*#__PURE__*/_jsx(\"div\",{cl